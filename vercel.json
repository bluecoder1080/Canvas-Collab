{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    },
    "http-backend": {
      "root": "apps/http-backend",
      "framework": "express",
      "buildCommand": "pnpm --filter @repo/shared build && pnpm --filter @repo/db build && pnpm build"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "http-backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
