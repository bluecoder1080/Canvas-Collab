{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "buildCommand": "pnpm --filter \"...web\" run build"
    },
    "http-backend": {
      "root": "apps/http-backend",
      "framework": "express",
      "entrypoint": "src/app.ts",
      "buildCommand": "pnpm --filter \"...http-backend\" run build"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "http-backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
